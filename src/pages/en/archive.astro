---
import ArchivePanel from "@components/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";
import { getActiveLocaleShort, setActiveLocale } from "@i18n/translation";

setActiveLocale(Astro.currentLocale);
const localeShort = getActiveLocaleShort();

const all = await getSortedPostsList();
const sortedPostsList = all.filter((p) => (p.data.lang || "zh") === localeShort);
---

<MainGridLayout title={i18n(I18nKey.archive)}>
    <ArchivePanel sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
</MainGridLayout>

