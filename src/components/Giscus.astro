---
import { giscusConfig } from "@/config";

const cfg = giscusConfig;
const data = {
	repo: cfg.repo,
	repoId: cfg.repoId,
	category: cfg.category,
	categoryId: cfg.categoryId,
	mapping: cfg.mapping,
	strict: cfg.strict,
	reactionsEnabled: cfg.reactionsEnabled,
	emitMetadata: cfg.emitMetadata,
	inputPosition: cfg.inputPosition,
	lang: cfg.lang,
};
---

{cfg.enabled && <div class="giscus mt-10" data-pagefind-ignore="true"></div>}

{cfg.enabled && (
	<script is:inline define:vars={{ cfg: data }}>
		(function () {
			function giscusTheme() {
				return document.documentElement.classList.contains("dark") ? "dark" : "light";
			}
			var lastUrl = "";
			function loadGiscus() {
				var container = document.querySelector(".giscus");
				if (!container) return;
				// 仅在文章路径变化或首次加载时重建，避免重复注入导致闪烁
				var current = location.pathname;
				if (lastUrl === current && container.querySelector("iframe.giscus-frame")) return;
				lastUrl = current;
				container.innerHTML = ""; // 清空旧 iframe，按当前文章重建
				var s = document.createElement("script");
				s.src = "https://giscus.app/client.js";
				s.async = true;
				s.crossOrigin = "anonymous";
				s.setAttribute("data-repo", cfg.repo);
				s.setAttribute("data-repo-id", cfg.repoId);
				s.setAttribute("data-category", cfg.category);
				s.setAttribute("data-category-id", cfg.categoryId);
				s.setAttribute("data-mapping", cfg.mapping);
				s.setAttribute("data-strict", cfg.strict);
				s.setAttribute("data-reactions-enabled", cfg.reactionsEnabled);
				s.setAttribute("data-emit-metadata", cfg.emitMetadata);
				s.setAttribute("data-input-position", cfg.inputPosition);
				s.setAttribute("data-theme", giscusTheme());
				s.setAttribute("data-lang", cfg.lang);
				container.appendChild(s);
			}
			// 首次加载（覆盖无 swup / 非 SPA 直达）
			loadGiscus();
			// SPA 导航（swup）后按新文章重建评论
			function registerGiscus() {
				window.swup.hooks.on("page:view", loadGiscus);
			}
			if (window.swup && window.swup.hooks) {
				registerGiscus();
			} else {
				document.addEventListener("swup:enable", registerGiscus);
			}
			// 跟随博客明暗主题切换
			var obs = new MutationObserver(function () {
				var frame = document.querySelector("iframe.giscus-frame");
				if (frame && frame.contentWindow) {
					frame.contentWindow.postMessage(
						{ giscus: { setConfig: { theme: giscusTheme() } } },
						"https://giscus.app",
					);
				}
			});
			obs.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
		})();
	</script>
)}
