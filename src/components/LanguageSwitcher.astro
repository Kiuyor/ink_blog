---
// Language switcher: links to the *same page* in the other locale.
// Post pages are matched by base slug (e.g. /posts/hello-im-ink/ ↔ /en/posts/hello-im-ink/);
// other pages just swap the /en prefix. Query strings (archive filters) are preserved.
import { getActiveLocaleShort } from "@i18n/translation";

const cur = getActiveLocaleShort(); // "zh" | "en"
const other = cur === "zh" ? "en" : "zh";
const otherLabel = other === "zh" ? "中文" : "EN";

let pathname = Astro.url.pathname;
let target: string;
if (cur === "zh") {
	// prepend /en
	target = "/" + ["en", ...pathname.split("/").filter(Boolean)].join("/");
	if (!target.endsWith("/")) target += "/";
} else {
	// strip leading /en
	target = pathname.replace(/^\/en(\/|$)/, "/");
	if (!target.endsWith("/")) target += "/";
}
const qs = Astro.url.search;
const href = target + qs;
---

<a
	href={href}
	class="btn-plain scale-animation rounded-lg h-11 px-3 font-bold active:scale-95 text-[var(--primary-text)] flex items-center"
	aria-label={`Switch to ${otherLabel}`}
	title={`Switch to ${otherLabel}`}
>
	{otherLabel}
</a>
